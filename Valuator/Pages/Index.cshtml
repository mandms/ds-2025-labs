@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="text-center">
    <form method="post">
        <div class="col-2">Текст для оценки: @Model.Port</div>
        <div class="col-10">
            <textarea id="text" name="text" rows="5" cols="50"></textarea>
            <input id="submit" type="submit" />
        </div>
    </form>
</div>