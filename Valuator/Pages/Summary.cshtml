@page
@model Valuator.Pages.SummaryModel
@{
}
@if (!string.IsNullOrEmpty(Model.AccessDeniedMessage))
{
    <p class="text-danger">@Model.AccessDeniedMessage</p>
}
else if (Model.Loading == true)
{
    <p>Оценка содержания не завершена</p>
}
else
{
    <p>Оценка содержания: @Model.Rank</p>
    <p>Плагиат: @Model.Similarity</p>
}
